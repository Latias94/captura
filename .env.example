# Captura Docker Compose example env file

# PostgreSQL service (docker-compose.yml)
POSTGRES_USER=captura
POSTGRES_PASSWORD=captura
POSTGRES_DB=captura

# Captura API
DATABASE_URL=postgres://captura:captura@db/captura
RUST_LOG=info
# SCHEDULER_ENABLED=true

# Reverse proxy auth (optional)
# If your reverse-proxy injects a trusted header with the authenticated username,
# set the header name here to enable proxy auth for Miniflux-compatible endpoints.
# When CAPTURA_AUTH_PROXY_USER_CREATION=1, missing users will be created on-the-fly.
CAPTURA_AUTH_PROXY_HEADER=
CAPTURA_AUTH_PROXY_USER_CREATION=0

# Security headers
# Enable global security headers on every response (recommended: 1)
CAPTURA_SECURITY_HEADERS=1
# Referrer Policy value
CAPTURA_REFERRER_POLICY=no-referrer
# Optional Content Security Policy; leave empty to skip setting CSP.
# Example (safe default for API-only service):
# CAPTURA_CSP=default-src 'none'; img-src 'self' data: https: http:; media-src 'self' data: https: http:; frame-ancestors 'none'; base-uri 'none'
CAPTURA_CSP=

# OIDC / Google OAuth2 (server-side Authorization Code)
# Enable and configure a single OIDC provider (e.g., Google: ISSUER=https://accounts.google.com)
CAPTURA_OIDC_ENABLED=0
CAPTURA_OIDC_ISSUER_URL=
CAPTURA_OIDC_CLIENT_ID=
CAPTURA_OIDC_CLIENT_SECRET=
CAPTURA_OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/oidc/callback
# Optional: state signing secret (fallback to random ephemeral if empty)
CAPTURA_OIDC_STATE_SECRET=
# Multiple OIDC providers (optional, JSON array)
# Example:
# CAPTURA_OIDC_PROVIDERS=[
#  {"name":"google","issuer_url":"https://accounts.google.com","client_id":"...","client_secret":"...","redirect_url":"http://localhost:8080/api/v1/auth/oidc/google/callback"}
# ]

# Login rate limit
CAPTURA_LOGIN_MAX_ATTEMPTS=10
CAPTURA_LOGIN_WINDOW_SECS=60

# Disable local auth (username/password & Basic password login)
CAPTURA_DISABLE_LOCAL_AUTH=0
